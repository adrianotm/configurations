{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "@slkiser/opencode-quota@2.16.0",
    "oh-my-opencode-slim",
    "openslimedit@1.0.4",
    "./plugins/caveman/plugin.js"
  ],

  "model": "github-copilot/claude-sonnet-4.6",
  "small_model": "github-copilot/gpt-5-mini",
  "share": "manual",

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 3,
    "preserve_recent_tokens": 12000,
    "reserved": 8000
  },

  "mcp": {
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    },
    "semaphore": {
      "type": "remote",
      "url": "https://mcp.semaphoreci.com/mcp",
      "oauth": {}
    },
    "codegraph": {
      "type": "local",
      "command": ["npx", "-y", "@colbymchenry/codegraph", "serve", "--mcp"],
      "environment": { "CODEGRAPH_TELEMETRY": "0" }
    }
  },

  "agent": {
    "build": {
      "description": "Primary build agent with full tool access",
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-4.6",
      "steps": 40
    },
    "plan": {
      "description": "Planning and analysis agent",
      "mode": "primary",
      "model": "github-copilot/claude-haiku-4.5"
    },
    "general": {
      "description": "General-purpose subagent for multi-step tasks",
      "mode": "subagent",
      "model": "github-copilot/gpt-5-mini",
      "steps": 15
    },
    "explore": {
      "description": "Fast read-only codebase exploration",
      "mode": "subagent",
      "model": "github-copilot/gpt-5-mini",
      "steps": 10
    }
  },

  "permission": {
    "bash": {
      "*": "ask",

      "rm*": "deny",
      "/bin/rm*": "deny",
      "sudo *": "deny",
      "sh -c \"rm *\"": "deny",
      "sh -c 'rm *'": "deny",
      "bash -c \"rm *\"": "deny",
      "bash -c 'rm *'": "deny",

      "dd *": "deny",
      "mkfs*": "deny",
      "truncate *": "deny",
      "> /dev/sd*": "deny",

      "chmod *": "deny",
      "chown *": "deny",
      "useradd *": "deny",
      "usermod *": "deny",
      "groupdel *": "deny",
      "passwd *": "deny",

      "systemctl *": "deny",
      "service *": "deny",
      "reboot": "deny",
      "shutdown*": "deny",
      "poweroff": "deny",

      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "wget * | bash": "deny",

      "apt *": "deny",
      "dnf *": "deny",
      "pacman *": "deny",
      "brew *": "deny",
      "pip install *": "deny",
      "npm install -g *": "deny",
      "nix-collect-garbage *": "deny",

      "mv /etc/*": "deny",
      "mv /boot/*": "deny",
      "mv /usr/*": "deny",
      "mv /var/*": "deny",

      "git commit*": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git rebase*": "ask",
      "git branch -D *": "ask"
    },

    "edit": {
      "./**": "ask",
      "/etc/**": "deny",
      "/boot/**": "deny",
      "/usr/**": "deny",
      "/var/**": "deny"
    },

    "external_directory": {
      "./**": "ask",
      "/etc/**": "deny",
      "/boot/**": "deny",
      "/usr/**": "deny",
      "/var/**": "deny"
    },

    "webfetch": "ask",
    "websearch": "ask",
    "skills": "ask"
  }
}
